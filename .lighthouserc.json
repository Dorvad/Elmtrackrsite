{
  "ci": {
    "collect": {
      "staticDistDir": "_site",
      "url": [
        "http://localhost/index.html",
        "http://localhost/he/index.html",
        "http://localhost/shift-tracker-android/index.html",
        "http://localhost/he/shift-tracker-android/index.html",
        "http://localhost/guides/how-to-track-work-hours/index.html",
        "http://localhost/privacy-and-security/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "budgetsPath": "./lighthouse-budgets.json"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "errors-in-console": ["warn", { "maxNumericValue": 0 }],
        "image-size-responsive": ["warn", {}],
        "resource-summary:total:size": ["warn", { "maxNumericValue": 1258000 }],
        "resource-summary:image:size": ["warn", { "maxNumericValue": 819000 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 123000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "_reports/lighthouse"
    }
  }
}
